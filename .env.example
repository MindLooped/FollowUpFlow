MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=http://localhost:5173,https://claude.ai

# Vite frontend (.env.local in project root)
VITE_API_URL=http://127.0.0.1:5000/api
